# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys / Data API.
# Never commit .env.local.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL= 
# Publishable key (sb_publishable_...). Safe for the browser; access is limited by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= 
