# Development image: runs `next dev` with hot reload against a bind-mounted source tree.
FROM node:24-alpine

WORKDIR /app

# COPY package.json package-lock.json ./
# RUN npm ci

# The desktop app's Electron binary (MSG-34) isn't needed in a container.
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci \
    --fetch-retries=5 \
    --fetch-timeout=300000

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
